{
  "name": "qg-desktop-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A two-layer Windows desktop companion for QG — a transparent desktop field and an on-demand task surface.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/generate-icons.cjs",
    "rebuild-native": "electron-rebuild -f -w desktop-host",
    "package": "npm run icons && npm run rebuild-native && electron-builder --win nsis zip"
  },
  "dependencies": {
    "desktop-host": "file:./native"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ca.ceomelyxja.qgdesktop",
    "productName": "QG Desktop",
    "artifactName": "QG-Desktop-${version}-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "asar": true,
    "asarUnpack": ["node_modules/desktop-host/build/Release/*.node"],
    "win": { "icon": "assets/qg.ico", "target": ["nsis", "zip"], "requestedExecutionLevel": "asInvoker" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QG Desktop",
      "installerIcon": "assets/qg.ico",
      "uninstallerIcon": "assets/qg.ico"
    }
  }
}
